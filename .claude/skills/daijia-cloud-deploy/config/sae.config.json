{
  "_说明": "SAE 部署配置,由 ~/.claude/skills/sae-microservice-deploy/scripts/sae.py 读取。只放资源 ID 和非密钥配置,密码来自项目根 .env(已 gitignore)。放在项目 skill daijia-cloud-deploy 里(与项目代码无关)。project_root 指向项目根,下面的相对路径都以它为基准。",
  "project_root": "../../../..",
  "region": "cn-shanghai",
  "namespace": "cn-shanghai:atguigu-daijia",
  "app_prefix": "daijia-",
  "network": {
    "_说明": "与天机学堂共用 VPC:NAS 挂载点在这个 VPC 里",
    "vpc": "vpc-uf6di68weekxptacmx4gf",
    "vswitch": "vsw-uf63gcgnayf8gy5ftty36",
    "security_group": "sg-uf6iqphf36pdng13dal2"
  },
  "registry": {
    "push_host": "crpi-eka315e4kto4gpp9.cn-shanghai.personal.cr.aliyuncs.com/default-images-space",
    "pull_host": "crpi-eka315e4kto4gpp9-vpc.cn-shanghai.personal.cr.aliyuncs.com/default-images-space",
    "pull_secret_name": "acr-personal-pull"
  },
  "nas": { "id": "031v1ru2rle6vnbjgge", "domain": "031v1ru2rle6vnbjgge-bxd4.cn-shanghai.nas.aliyuncs.com" },
  "config": {
    "env_file": ".env",
    "configmap_name": "daijia-env",
    "secret_name": "daijia-secrets",
    "secret_mount": "/etc/daijia-secrets",
    "configmap_fixed": {
      "TZ": "Asia/Shanghai",
      "DAIJIA_MYSQL_HOST": "{svc:mysql}",
      "DAIJIA_REDIS_HOST": "{svc:redis}",
      "DAIJIA_MONGO_HOST": "{svc:mongo}",
      "DAIJIA_RABBITMQ_HOST": "{svc:rabbitmq}",
      "DAIJIA_XXLJOB_HOST": "{svc:xxl-job}",
      "SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR": "{svc:nacos}:8848",
      "SPRING_CLOUD_NACOS_CONFIG_SERVER_ADDR": "{svc:nacos}:8848",
      "WX_PAY_PRIVATE_KEY_PATH": "/etc/daijia-secrets/wxpay_apiclient_key.pem",
      "WX_PAY_PUBLIC_KEY_PATH": "/etc/daijia-secrets/wxpay_pub_key.pem"
    },
    "secret_map": {
      "mysql.root.password": "SAE_MYSQL_ROOT_PASSWORD",
      "spring.datasource.password": "SAE_MYSQL_ROOT_PASSWORD",
      "rabbitmq.default.pass": "SAE_RABBITMQ_PASSWORD",
      "redis.password": "SAE_REDIS_PASSWORD",
      "mongo.password": "SAE_MONGO_PASSWORD",
      "daijia.redis.password": "SAE_REDIS_PASSWORD",
      "WX_APP_ID": "APP_ID",
      "WX_APP_SECRET": "APP_SECRET"
    },
    "secret_format": { "daijia.mongo.auth": "root:{SAE_MONGO_PASSWORD}@" },
    "secret_from_env": ["WX_PAY_MCH_ID", "WX_PAY_SERIAL_NO", "WX_PAY_API_V3_KEY", "WX_PAY_PUBLIC_KEY_ID",
                        "TENCENT_CLOUD_SECRET_ID", "TENCENT_CLOUD_SECRET_KEY"],
    "secret_files": [["wxpay_apiclient_key.pem", "WX_PAY_PRIVATE_KEY_PATH"], ["wxpay_pub_key.pem", "WX_PAY_PUBLIC_KEY_PATH"]],
    "configmap_files": [
      { "name": "daijia-mysql-conf", "files": [".claude/skills/daijia-cloud-deploy/config/mysql/daijia.cnf"] },
      { "name": "daijia-mysql-init", "files": [
        ".claude/skills/daijia-cloud-deploy/.generated/mysql-init/01-nacos.sql",
        ".claude/skills/daijia-cloud-deploy/.generated/mysql-init/02-daijia.sql",
        ".claude/skills/daijia-cloud-deploy/.generated/mysql-init/03-xxl-job.sql"
      ] },
      { "name": "daijia-redis-conf", "files": [".claude/skills/daijia-cloud-deploy/config/redis/redis.conf"] },
      { "name": "daijia-mongo-conf", "files": [".claude/skills/daijia-cloud-deploy/config/mongo/mongod.conf"] }
    ]
  },
  "expose": {
    "_说明": "中间件端口:与网关共用公网 CLB(cloud.clb_name),这些监听全部套同一个 IP 白名单,供本地 IDEA 直连和推送 Nacos 配置。换网络后 acl-sync 追加当前出口 IP。",
    "clb_name": "daijia",
    "acl_name": "daijia-dev-acl",
    "ports": {
      "mysql": [3306],
      "redis": [6379],
      "mongo": [27017],
      "rabbitmq": [5672],
      "nacos": [8848, 9848],
      "xxl-job": [8080]
    }
  },
  "java_base": "anolis-registry.cn-zhangjiakou.cr.aliyuncs.com/openanolis/openjdk:17-8.6",
  "cloud": {
    "_说明": "项目 skill daijia-cloud-deploy 读取。镜像全部放一个私有仓库 repo,微服务标签 <应用>-<源码哈希>(image 写的是不带哈希的前缀)。网关绑同一个公网 CLB 的 gateway_port,对全网开放;实例经 NAT 网关出公网(微信登录/支付、腾讯云、地图)。",
    "repo": "daijia",
    "gateway_app": "server-gateway",
    "gateway_port": 8600,
    "nat_name": "daijia-nat",
    "eip_name": "daijia-nat-eip",
    "notify_env": "WX_PAY_NOTIFY_URL"
  },
  "defaults": { "sae_version": "std", "envs": { "TZ": "Asia/Shanghai" } },
  "apps": {
    "mysql": {
      "kind": "middleware", "layer": 1, "image": "default-images-house:mysql-8.0.29", "cpu": 500, "mem": 1024,
      "ports": [3306], "live_delay": 300, "secret": true,
      "envs": { "MYSQL_ROOT_PASSWORD_FILE": "/etc/daijia-secrets/mysql.root.password" },
      "config_files": [
        { "configmap": "daijia-mysql-conf", "mount": "/etc/mysql/conf.d" },
        { "configmap": "daijia-mysql-init", "mount": "/docker-entrypoint-initdb.d" }
      ],
      "nas": { "path": "/daijia/mysql", "mount": "/var/lib/mysql", "owner": "999:999" }
    },
    "redis": {
      "kind": "middleware", "layer": 1, "image": "default-images-house:redis-7.0.4", "ports": [6379], "live_delay": 60, "secret": true,
      "command": "sh",
      "command_args": ["-c", "exec docker-entrypoint.sh redis-server /etc/redis/redis.conf --requirepass \"$(cat /etc/daijia-secrets/redis.password)\""],
      "config_files": [{ "configmap": "daijia-redis-conf", "mount": "/etc/redis" }],
      "nas": { "path": "/daijia/redis", "mount": "/data", "owner": "999:999" }
    },
    "rabbitmq": {
      "kind": "middleware", "layer": 1, "image": "default-images-house:rabbitmq-3.9.17-delayed", "ports": [5672, 15672],
      "live_delay": 180, "secret": true,
      "command": "sh",
      "command_args": ["-c", "export RABBITMQ_DEFAULT_PASS=\"$(cat /etc/daijia-secrets/rabbitmq.default.pass)\"; exec docker-entrypoint.sh rabbitmq-server"],
      "envs": {
        "RABBITMQ_NODENAME": "rabbit@localhost",
        "RABBITMQ_DEFAULT_USER": "admin",
        "RABBITMQ_DEFAULT_VHOST": "/"
      },
      "nas": { "path": "/daijia/rabbitmq", "mount": "/var/lib/rabbitmq", "owner": "999:999" }
    },
    "mongo": {
      "kind": "middleware", "layer": 1, "image": "default-images-house:mongo-4.4", "ports": [27017], "live_delay": 90, "secret": true,
      "_说明": "NAS 上已有无认证的旧数据,MONGO_INITDB_ROOT_* 不会生效:先用无认证的临时实例建/改 root 用户(幂等),关掉后再带认证正式启动。",
      "command": "sh", "command_args": ["-c", "set -e; PW=\"$(cat /etc/daijia-secrets/mongo.password)\"; gosu mongodb mongod --fork --logpath /tmp/init.log --dbpath /data/db --bind_ip 127.0.0.1; mongo --quiet admin --eval \"var u=db.getUser('root'); if(!u){db.createUser({user:'root',pwd:'$PW',roles:['root']})}else{db.changeUserPassword('root','$PW')}\"; gosu mongodb mongod --dbpath /data/db --shutdown; exec docker-entrypoint.sh mongod --config /etc/mongo/mongod.conf"],
      "config_files": [{ "configmap": "daijia-mongo-conf", "mount": "/etc/mongo" }],
      "nas": { "path": "/daijia/mongo", "mount": "/data/db", "owner": "999:999" }
    },
    "nacos": {
      "kind": "middleware", "layer": 2, "image": "default-images-house:nacos-2.1.0-slim", "ports": [8848, 9848],
      "micro_registration": 1,
      "live_delay": 180, "settle_seconds": 60, "secret": true,
      "command": "sh",
      "command_args": ["-c", "unset JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS; export MYSQL_SERVICE_PASSWORD=\"$(cat /etc/daijia-secrets/mysql.root.password)\"; exec bin/docker-startup.sh"],
      "envs": {
        "MODE": "standalone",
        "PREFER_HOST_MODE": "hostname",
        "SPRING_DATASOURCE_PLATFORM": "mysql",
        "MYSQL_SERVICE_HOST": "{svc:mysql}",
        "MYSQL_SERVICE_PORT": "3306",
        "MYSQL_SERVICE_DB_NAME": "nacos",
        "MYSQL_SERVICE_USER": "root",
        "MYSQL_SERVICE_DB_PARAM": "characterEncoding=utf8&connectTimeout=3000&socketTimeout=10000&autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai",
        "JVM_XMS": "384m",
        "JVM_XMX": "384m",
        "JVM_XMN": "128m"
      }
    },
    "xxl-job": {
      "kind": "middleware", "layer": 2, "image": "daijia:xxl-job-2.3.0", "ports": [8080], "live_delay": 150, "secret": true,
      "envs": {
        "SPRING_DATASOURCE_URL": "jdbc:mysql://{svc:mysql}:3306/xxl_job?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true",
        "SPRING_DATASOURCE_USERNAME": "root",
        "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/",
        "XXL_JOB_ACCESSTOKEN": "default_token",
        "JAVA_TOOL_OPTIONS": "-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m"
      },
      "build": {
        "dockerfile": ".claude/skills/daijia-cloud-deploy/docker/xxl-job.Dockerfile",
        "base": "crpi-eka315e4kto4gpp9.cn-shanghai.personal.cr.aliyuncs.com/default-images-space/default-images-house:xxl-job-admin-2.3.0",
        "files": { "infra/artifacts/xxl-job-admin.jar": "xxl-job-admin.jar" }
      }
    },
    "service-coupon": {
      "kind": "java", "layer": 3, "image": "daijia:service-coupon", "cpu": 500, "mem": 1024, "probe_port": 8511, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-coupon",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-coupon/target/service-coupon.jar" }
    },
    "service-customer": {
      "kind": "java", "layer": 3, "image": "daijia:service-customer", "cpu": 500, "mem": 1024, "probe_port": 8501, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-customer",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-customer/target/service-customer.jar" }
    },
    "service-dispatch": {
      "kind": "java", "layer": 3, "image": "daijia:service-dispatch", "cpu": 500, "mem": 1024, "probe_port": 8509, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-dispatch",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-dispatch/target/service-dispatch.jar" }
    },
    "service-driver": {
      "kind": "java", "layer": 3, "image": "daijia:service-driver", "cpu": 500, "mem": 1024, "probe_port": 8502, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-driver",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-driver/target/service-driver.jar" }
    },
    "service-map": {
      "kind": "java", "layer": 3, "image": "daijia:service-map", "cpu": 500, "mem": 1024, "probe_port": 8503, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-map",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-map/target/service-map.jar" }
    },
    "service-mq": {
      "kind": "java", "layer": 3, "image": "daijia:service-mq", "cpu": 500, "mem": 1024, "probe_port": 8282, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-mq",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-mq/target/service-mq.jar" }
    },
    "service-order": {
      "kind": "java", "layer": 3, "image": "daijia:service-order", "cpu": 500, "mem": 1024, "probe_port": 8505, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-order",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-order/target/service-order.jar" }
    },
    "service-payment": {
      "kind": "java", "layer": 3, "image": "daijia:service-payment", "cpu": 500, "mem": 1024, "probe_port": 8506, "live_delay": 300,
      "configmap": true, "secret": true, "module": "daijia-parent/service/service-payment",
      "envs": { "JAVA_OPTS": "-Xms256m -Xmx640m -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8", "SPRING_CONFIG_IMPORT": "optional:configtree:/etc/daijia-secrets/" },
      "build": { "jar": "daijia-parent/service/service-payment/target/service-payment.jar" }
